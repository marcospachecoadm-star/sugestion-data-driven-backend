rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function tenantId() {
      return request.auth.token.empresa_id;
    }

    function isTenantDoc() {
      return signedIn() &&
        tenantId() != null &&
        resource.data.empresa_id == tenantId();
    }

    function isCreatingTenantDoc() {
      return signedIn() &&
        tenantId() != null &&
        request.resource.data.empresa_id == tenantId();
    }

    function isServiceAdmin() {
      return signedIn() && request.auth.token.admin == true;
    }

    function isChangingProtectedUserFields() {
      return request.resource.data.diff(resource.data).affectedKeys().hasAny([
        "empresa_id",
        "empresaId",
        "tenant_id",
        "admin",
        "role",
        "roles",
        "permissoes",
        "plano"
      ]);
    }

    match /usuarios/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || isServiceAdmin());
      allow create: if signedIn() && request.auth.uid == userId;
      allow update: if isServiceAdmin() ||
        (signedIn() && request.auth.uid == userId && !isChangingProtectedUserFields());
      allow delete: if isServiceAdmin();
    }

    match /empresas/{empresaId} {
      allow read: if signedIn() && (tenantId() == empresaId || isServiceAdmin());
      allow write: if isServiceAdmin();
    }

    match /produtos/{docId} {
      allow read: if isTenantDoc() || isServiceAdmin();
      allow create: if isCreatingTenantDoc() || isServiceAdmin();
      allow update, delete: if isTenantDoc() || isServiceAdmin();
    }

    match /estoque/{docId} {
      allow read: if isTenantDoc() || isServiceAdmin();
      allow create: if isCreatingTenantDoc() || isServiceAdmin();
      allow update, delete: if isTenantDoc() || isServiceAdmin();
    }

    match /vendas/{docId} {
      allow read: if isTenantDoc() || isServiceAdmin();
      allow create: if isCreatingTenantDoc() || isServiceAdmin();
      allow update, delete: if isTenantDoc() || isServiceAdmin();
    }

    match /indicadoresResumo/{docId} {
      allow read: if isTenantDoc() || isServiceAdmin();
      allow write: if isServiceAdmin();
    }

    match /indicadoresItens/{docId} {
      allow read: if isTenantDoc() || isServiceAdmin();
      allow write: if isServiceAdmin();
    }

    match /alertas/{docId} {
      allow read: if isTenantDoc() || isServiceAdmin();
      allow update: if isTenantDoc() || isServiceAdmin();
      allow create, delete: if isServiceAdmin();
    }

    match /acoesRecomendadas/{docId} {
      allow read: if isTenantDoc() || isServiceAdmin();
      allow update: if isTenantDoc() || isServiceAdmin();
      allow create, delete: if isServiceAdmin();
    }

    match /sugestoesCompra/{docId} {
      allow read: if isTenantDoc() || isServiceAdmin();
      allow update: if isTenantDoc() || isServiceAdmin();
      allow create, delete: if isServiceAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
