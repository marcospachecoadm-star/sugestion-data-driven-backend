rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return firestore.get(
        /databases/(default)/documents/usuarios/$(request.auth.uid)
      ).data;
    }

    function canUploadCsv(empresaId) {
      return signedIn()
        && userDoc().ativo == true
        && userDoc().empresa_id == empresaId
        && (
          userDoc().perfil in ["admin", "gestor", "compras"]
          || userDoc().role in ["admin", "gestor", "compras"]
        );
    }

    function canReadTenantFile(empresaId) {
      return signedIn()
        && userDoc().ativo == true
        && userDoc().empresa_id == empresaId;
    }

    match /uploads/{empresaId}/{fileName} {
      allow create, update: if canUploadCsv(empresaId)
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType in [
          "text/csv",
          "application/csv",
          "application/vnd.ms-excel",
          "application/octet-stream"
        ]
        && fileName.matches("^" + empresaId + "_(produtos|estoque|vendas)_.*\\.csv$");

      allow read: if canReadTenantFile(empresaId);
      allow delete: if false;
    }

    match /processada/{empresaId}/{fileName} {
      allow read, write: if false;
    }

    match /erro/{empresaId}/{fileName} {
      allow read, write: if false;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
