rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function tenantId() {
      return request.auth.token.empresa_id;
    }

    function isTenantUpload(empresaId) {
      return signedIn() && tenantId() == empresaId;
    }

    match /uploads/{empresaId}/{fileName} {
      allow read: if isTenantUpload(empresaId);
      allow write: if isTenantUpload(empresaId) &&
        request.resource.size < 10 * 1024 * 1024 &&
        fileName.matches('.*\\.csv');
    }

    match /processada/{empresaId}/{fileName} {
      allow read: if isTenantUpload(empresaId);
      allow write: if false;
    }

    match /erro/{empresaId}/{fileName} {
      allow read: if isTenantUpload(empresaId);
      allow write: if false;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
